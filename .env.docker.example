# HotFii — VPS / Docker environment.
#
#   cp .env.docker.example .env
#   nano .env          # fill in every REPLACE_ME
#
# This one file is read twice: by Compose for ${...} substitution in
# docker-compose.yml, and by every PHP container through env_file. Keep it at
# chmod 600 and never commit it.

# ── Identity ────────────────────────────────────────────────────────────────
# APP_DOMAIN is the bare hostname, no scheme and no trailing slash. It drives
# the nginx server_name and the Let's Encrypt certificate.
APP_DOMAIN=hotfii.example.com
LETSENCRYPT_EMAIL=you@example.com

APP_NAME=HotFii
APP_ENV=production
# Left blank on purpose. Generate it once, after the first `up`:
#   docker compose exec -u www-data app php artisan key:generate --force
# then restart the PHP services so every container reads the new key.
APP_KEY=
APP_DEBUG=false
APP_URL=https://hotfii.example.com
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12

# Containers log to stdout/stderr, so `docker compose logs` is the only place to
# look and there is no log file to rotate or share between containers.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# DB_HOST is the compose service name. DB_PASSWORD also initialises the
# postgres container on first boot, so changing it later needs a manual
# ALTER ROLE inside the database.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hotfii
DB_USERNAME=hotfii
DB_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# Least-privilege login FreeRADIUS uses: read-only on the credential tables,
# read-write only on radacct and radpostauth.
RADIUS_DB_PASSWORD=REPLACE_ME_WITH_ANOTHER_LONG_RANDOM_STRING

# ── Redis, cache, queue, sessions ───────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=150

# ── Mail ────────────────────────────────────────────────────────────────────
# `log` writes to the container log, which is fine until you wire a real
# provider. Password resets and email verification stay undelivered until then.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@hotfii.example.com
MAIL_FROM_NAME=HotFii
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# ── Reverb (WebSockets) ─────────────────────────────────────────────────────
# The container listens on 8080 internally; browsers reach it through nginx on
# 443, which is why REVERB_PORT is 443 and REVERB_SCHEME is https.
#
# Values are written out in full rather than as ${REVERB_APP_KEY} references:
# Compose hands env_file values to the container verbatim, and there is no .env
# inside the image for Laravel's dotenv to expand them.
#
# The browser-side VITE_REVERB_* variables are not listed here. Compose derives
# them from these values and passes them as build args, because Vite inlines
# them into the JS bundle at build time. Changing REVERB_APP_KEY means
# `docker compose up -d --build`.
REVERB_APP_ID=hotfii
REVERB_APP_KEY=REPLACE_ME_WITH_A_RANDOM_STRING
REVERB_APP_SECRET=REPLACE_ME_WITH_A_RANDOM_STRING
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=hotfii.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=hotfii.example.com

# ── Paystack ────────────────────────────────────────────────────────────────
# Live keys start pk_live_ / sk_live_. Set the webhook URL in the Paystack
# dashboard to https://<APP_DOMAIN>/webhooks/paystack
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

# ── HotFii commerce rules ───────────────────────────────────────────────────
HOTFII_PLATFORM_FEE_BPS=200
HOTFII_STANDARD_MINIMUM_KOBO=250000
HOTFII_MINIMUM_INCLUDED_SALES_KOBO=5000000
HOTFII_MICRO_SALES_LIMIT_KOBO=5000000
HOTFII_TRIAL_SALES_CAP_KOBO=10000000
HOTFII_TRIAL_DAYS=14

# ── RADIUS ──────────────────────────────────────────────────────────────────
# This is the address routers point at, and the address the queue container
# sends CoA/Disconnect to. Use the VPS public IP, not the compose service name:
# routers on the internet resolve it, and radclient reaches the published
# 1812/1813 UDP ports through the host.
HOTFII_RADIUS_HOST=203.0.113.10
HOTFII_RADIUS_AUTH_PORT=1812
HOTFII_RADIUS_ACCT_PORT=1813
HOTFII_COA_PORT=3799

# Secret for the 127.0.0.1 client inside the freeradius container, which exists
# only so `radtest` smoke tests work. Not reachable from outside the container.
RADIUS_LOCALHOST_SECRET=hotfii-loopback

# ── WireGuard (optional, for routers behind CGNAT) ──────────────────────────
HOTFII_WIREGUARD_SERVER_PUBLIC_KEY=
HOTFII_WIREGUARD_ENDPOINT=
HOTFII_WIREGUARD_PORT=51820
HOTFII_WIREGUARD_ALLOWED_ADDRESSES=10.77.0.0/16

# ── Build ───────────────────────────────────────────────────────────────────
# Leave as --no-dev for production. Set to an empty value to build an image that
# includes PHPUnit and friends so `php artisan test` can run in the container.
COMPOSER_FLAGS=--no-dev
