# The instance name must be `sql`. sites-available/default references the module
# as a bare `-sql`, so an instance named anything else is silently never called
# and every request falls through to reject.

sql {
    dialect = "postgresql"
    driver = "rlm_sql_${dialect}"

    server = "HOTFII_POSTGRES_HOST"
    port = 5432
    login = "hotfii_radius"
    password = "REPLACE_ME"

    # In FreeRADIUS 3 radius_db is the database name; there is no `database`
    # parameter.
    radius_db = "hotfii"

    read_clients = yes
    client_table = "nas"
    group_attribute = "SQL-Group"

    pool {
        start = 3
        min = 2
        max = 16
        spare = 3
        uses = 0
        retry_delay = 30
        lifetime = 0
        idle_timeout = 60
    }

    $INCLUDE ${modconfdir}/${.:name}/main/${dialect}/queries.conf
}
