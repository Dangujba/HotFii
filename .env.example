APP_NAME=HotFii
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hotfii.test
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hotfii
DB_USERNAME=hotfii
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=150

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@hotfii.net
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=hotfii-local
REVERB_APP_KEY=hotfii-local-key
REVERB_APP_SECRET=change-this-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=hotfii.test,localhost,127.0.0.1
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_NAME="${APP_NAME}"

PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

HOTFII_PLATFORM_FEE_BPS=200
HOTFII_STANDARD_MINIMUM_KOBO=250000
HOTFII_MICRO_SALES_LIMIT_KOBO=5000000
HOTFII_TRIAL_SALES_CAP_KOBO=10000000
HOTFII_TRIAL_DAYS=14

HOTFII_RADIUS_HOST=192.0.2.10
HOTFII_RADIUS_AUTH_PORT=1812
HOTFII_RADIUS_ACCT_PORT=1813
HOTFII_COA_PORT=3799

HOTFII_WIREGUARD_SERVER_PUBLIC_KEY=
HOTFII_WIREGUARD_ENDPOINT=
HOTFII_WIREGUARD_PORT=51820
HOTFII_WIREGUARD_ALLOWED_ADDRESSES=10.77.0.0/16